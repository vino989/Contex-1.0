# PostgreSQL connection string from your hosting provider
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Generate with: openssl rand -hex 32
JWT_SECRET=replace_with_at_least_32_random_characters
# Generate with: openssl rand -hex 32. Used only once to initialize account 12111.
OWNER_SETUP_KEY=replace_with_a_long_random_secret
PORT=3000
# Optional comma-separated app origins; omit for non-browser clients
# CORS_ORIGIN=https://your-dashboard.example
